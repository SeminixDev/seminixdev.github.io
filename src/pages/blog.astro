---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';

const allPosts    = await getCollection('posts');
const allProjects = await getCollection('projects');

const posts = allPosts.sort((a, b) => b.data.date.localeCompare(a.data.date));

const projectMap = Object.fromEntries(allProjects.map((p) => [p.id, p.data.title]));
---

<BaseLayout
  title="Blog"
  description="Piotr Moskala - Development Blog"
>
  <section class="container">
    <h1 class="section-title" style="margin-top:2rem;">// Blog</h1>

    {posts.length > 0 ? (
      <div class="blog-grid">
        {posts.map((post) => (
          <BlogCard
            post={post}
            projectTitle={post.data.projectId ? projectMap[post.data.projectId] : undefined}
          />
        ))}
      </div>
    ) : (
      <p class="no-projects">No posts yet — check back soon!</p>
    )}
  </section>
</BaseLayout>
